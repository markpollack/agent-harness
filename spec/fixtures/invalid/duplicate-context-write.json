{
  "apiVersion": "workflow/v2alpha",
  "kind": "Workflow",
  "metadata": {"name": "duplicate-context-write", "version": "1.0.0"},
  "operations": {"work": {"ref": "java:test.work:v1"}},
  "nodes": [
    {"id": "a", "kind": "task", "operation": "work",
     "contextWrites": {"k": {"from": "$input.x"}, "k": {"from": "$input.y"}}},
    {"id": "end", "kind": "terminate", "status": "completed"}
  ],
  "edges": [{"from": "a", "to": "end", "when": {"kind": "always"}}],
  "entrypoint": "a"
}
