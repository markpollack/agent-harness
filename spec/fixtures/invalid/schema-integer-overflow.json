{
  "apiVersion": "workflow/v2alpha",
  "kind": "Workflow",
  "metadata": {
    "name": "schema-integer-overflow",
    "version": "1.0.0"
  },
  "operations": {
    "work": {
      "ref": "java:test.work:v1"
    }
  },
  "nodes": [
    {
      "id": "a",
      "kind": "task",
      "operation": "work"
    },
    {
      "id": "end",
      "kind": "terminate",
      "status": "completed"
    }
  ],
  "edges": [
    {
      "from": "a",
      "to": "end",
      "when": {
        "kind": "always"
      }
    }
  ],
  "entrypoint": "a",
  "policies": {
    "retry": {
      "maxAttempts": 99999999999999999999999999
    }
  }
}
