{
  "apiVersion": "workflow/v2alpha",
  "kind": "Workflow",
  "metadata": {
    "name": "schema-binding-space-in-key",
    "version": "1.0.0"
  },
  "operations": {
    "work": {
      "ref": "java:test.work:v1"
    }
  },
  "nodes": [
    {
      "id": "a",
      "kind": "task",
      "operation": "work",
      "input": {
        "x": {
          "from": "$context.a b"
        }
      }
    },
    {
      "id": "end",
      "kind": "terminate",
      "status": "completed"
    }
  ],
  "edges": [
    {
      "from": "a",
      "to": "end",
      "when": {
        "kind": "always"
      }
    }
  ],
  "entrypoint": "a"
}
