{
  "apiVersion": "workflow/v2alpha",
  "kind": "Workflow",
  "metadata": {
    "name": "duplicate-outcome-edge",
    "version": "1.0.0"
  },
  "operations": {
    "work": {
      "ref": "java:test.work:v1"
    },
    "route": {
      "ref": "java:test.route:v1"
    }
  },
  "nodes": [
    {
      "id": "d",
      "kind": "decision",
      "operation": "route",
      "outcomes": [
        "a"
      ]
    },
    {
      "id": "t",
      "kind": "task",
      "operation": "work"
    },
    {
      "id": "u",
      "kind": "task",
      "operation": "work"
    },
    {
      "id": "end",
      "kind": "terminate",
      "status": "completed"
    }
  ],
  "edges": [
    {
      "from": "d",
      "to": "t",
      "when": {
        "kind": "decisionResult",
        "value": "a"
      }
    },
    {
      "from": "d",
      "to": "u",
      "when": {
        "kind": "decisionResult",
        "value": "a"
      }
    },
    {
      "from": "t",
      "to": "end",
      "when": {
        "kind": "always"
      }
    },
    {
      "from": "u",
      "to": "end",
      "when": {
        "kind": "always"
      }
    }
  ],
  "entrypoint": "d"
}
